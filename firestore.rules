rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Target Firebase Project: lingowords-88ed4 (Cloud Firestore Standard edition)
// App: LingoWords (SlovickaSpeak Android)
//
// Collection: leaderboard
// Document ID: {uid} (Firebase Auth UID, including Anonymous Auth)
// Access Pattern:
//   - Read: Any authenticated user (request.auth != null)
//   - Create / Update / Delete: Strictly the document owner (request.auth.uid == uid)
//   - PII Protection: No raw email or other PII is permitted in this collection.
// Fields (all 19 fields required; no extraneous fields allowed):
//   - uid: string (required, immutable, size 1..128, must equal {uid} and request.auth.uid)
//   - code: string (required, size 5..24, matches '^SLOV-[A-Z0-9]{1,19}$')
//   - name: string (required, size 1..60)
//   - date: string (required, size 10, matches '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
//   - lastActiveDate: string (required, size <= 10, '' or 'YYYY-MM-DD')
//   - languageCode: string (required, size 2, in ['en', 'es', 'de', 'fr', 'it'])
//   - todayCompleted: int (required, 0..5000)
//   - todayXp: int (required, 0..10000)
//   - weeklyCompleted: int (required, 0..30000)
//   - weeklyXp: int (required, 0..50000)
//   - dailyGoal: int (required, 1..500)
//   - streakDays: int (required, 0..10000)
//   - totalSpoken: int (required, 0..1000000)
//   - masteredCount: int (required, 0..50000)
//   - totalCorrect: int (required, 0..2000000)
//   - completedSessions: int (required, 0..100000)
//   - accuracyPercent: int (required, 0..100)
//   - catalogWordCount: int (required, 0..50000)
//   - ts: int (required, >= 0)
//
// Collection: user_backups
// Document ID: {uid} (Non-anonymous Firebase Auth UID, e.g., Google Sign-In)
// Access Pattern:
//   - Read / Create / Update / Delete: Strictly the non-anonymous document owner
//     (request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous')
// Fields (all 25 fields required; no extraneous fields allowed):
//   - uid: string (required, immutable, size 1..128, must equal {uid} and request.auth.uid)
//   - updatedAt: int (required, >= 0)
//   - dailyGoal: int (required, 1..500)
//   - isDarkMode: bool (required)
//   - autoPronounceEnabled: bool (required)
//   - pauseCardWhileSpeaking: bool (required)
//   - studyReminderEnabled: bool (required)
//   - studyReminderHour: int (required, 0..23)
//   - studyReminderMinute: int (required, 0..59)
//   - selectedLanguage: string (required, in ['ENGLISH', 'SPANISH', 'GERMAN', 'FRENCH', 'ITALIAN'])
//   - selectedCefrLevel: string (required, size 0..8)
//   - studyDirection: string (required, in ['NATIVE_TO_FOREIGN', 'FOREIGN_TO_NATIVE', 'MIX'])
//   - todayDate: string (required, size 10, matches '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
//   - todayCompleted: int (required, 0..5000)
//   - todayBaseXp: int (required, 0..10000)
//   - weeklyDailyLog: string (required, size 0..20000)
//   - totalAttempts: int (required, 0..5000000)
//   - totalCorrect: int (required, 0..5000000)
//   - totalSpoken: int (required, 0..2000000)
//   - completedSessions: int (required, 0..200000)
//   - streakDays: int (required, 0..10000)
//   - lastStudyDate: string (required, size 0..10, '' or 'YYYY-MM-DD')
//   - masteredWordIds: string (required, size 0..400000)
//   - needsReviewWordIds: string (required, size 0..200000)
//   - wordSrsStats: string (required, size 0..600000)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (including Firebase Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the document path UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated owner signed in with a non-anonymous provider (e.g., Google Sign-In)
    function isNonAnonymousOwner(userId) {
      return isOwner(userId) &&
        'firebase' in request.auth.token &&
        'sign_in_provider' in request.auth.token.firebase &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Verify UID matches the authenticated caller on create
    function uidUnchanged() {
      return ('uid' in request.resource.data) &&
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure UID field is not modified on update
    function uidNotModified() {
      return ('uid' in request.resource.data) &&
        request.resource.data.uid == resource.data.uid;
    }

    // Validate that all required fields exist in the resulting document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields have not changed on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate string type and inclusive length bounds
    function validStringLength(val, minLen, maxLen) {
      return val is string &&
        val.size() >= minLen &&
        val.size() <= maxLen;
    }

    // Validate integer type and inclusive range bounds
    function isIntInRange(val, minVal, maxVal) {
      return val is int &&
        val >= minVal &&
        val <= maxVal;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidLeaderboardEntry(data, uid) {
      let allowedFields = [
        'uid',
        'code',
        'name',
        'date',
        'lastActiveDate',
        'languageCode',
        'todayCompleted',
        'todayXp',
        'weeklyCompleted',
        'weeklyXp',
        'dailyGoal',
        'streakDays',
        'totalSpoken',
        'masteredCount',
        'totalCorrect',
        'completedSessions',
        'accuracyPercent',
        'catalogWordCount',
        'ts'
      ];

      return hasRequiredFields(allowedFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength(data.uid, 1, 128) &&
        data.uid == uid &&
        data.uid == request.auth.uid &&
        validStringLength(data.code, 5, 24) &&
        data.code.matches('^SLOV-[A-Z0-9]{1,19}$') &&
        validStringLength(data.name, 1, 60) &&
        validStringLength(data.date, 10, 10) &&
        data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        validStringLength(data.lastActiveDate, 0, 10) &&
        (data.lastActiveDate == '' || data.lastActiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
        validStringLength(data.languageCode, 2, 2) &&
        data.languageCode in ['en', 'es', 'de', 'fr', 'it'] &&
        isIntInRange(data.todayCompleted, 0, 5000) &&
        isIntInRange(data.todayXp, 0, 10000) &&
        isIntInRange(data.weeklyCompleted, 0, 30000) &&
        isIntInRange(data.weeklyXp, 0, 50000) &&
        isIntInRange(data.dailyGoal, 1, 500) &&
        isIntInRange(data.streakDays, 0, 10000) &&
        isIntInRange(data.totalSpoken, 0, 1000000) &&
        isIntInRange(data.masteredCount, 0, 50000) &&
        isIntInRange(data.totalCorrect, 0, 2000000) &&
        isIntInRange(data.completedSessions, 0, 100000) &&
        isIntInRange(data.accuracyPercent, 0, 100) &&
        isIntInRange(data.catalogWordCount, 0, 50000) &&
        data.ts is int &&
        data.ts >= 0;
    }

    function isValidUserBackup(data, uid) {
      let allowedFields = [
        'uid',
        'updatedAt',
        'dailyGoal',
        'isDarkMode',
        'autoPronounceEnabled',
        'pauseCardWhileSpeaking',
        'studyReminderEnabled',
        'studyReminderHour',
        'studyReminderMinute',
        'selectedLanguage',
        'selectedCefrLevel',
        'studyDirection',
        'todayDate',
        'todayCompleted',
        'todayBaseXp',
        'weeklyDailyLog',
        'totalAttempts',
        'totalCorrect',
        'totalSpoken',
        'completedSessions',
        'streakDays',
        'lastStudyDate',
        'masteredWordIds',
        'needsReviewWordIds',
        'wordSrsStats'
      ];

      return hasRequiredFields(allowedFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength(data.uid, 1, 128) &&
        data.uid == uid &&
        data.uid == request.auth.uid &&
        data.updatedAt is int &&
        data.updatedAt >= 0 &&
        isIntInRange(data.dailyGoal, 1, 500) &&
        data.isDarkMode is bool &&
        data.autoPronounceEnabled is bool &&
        data.pauseCardWhileSpeaking is bool &&
        data.studyReminderEnabled is bool &&
        isIntInRange(data.studyReminderHour, 0, 23) &&
        isIntInRange(data.studyReminderMinute, 0, 59) &&
        validStringLength(data.selectedLanguage, 6, 7) &&
        data.selectedLanguage in ['ENGLISH', 'SPANISH', 'GERMAN', 'FRENCH', 'ITALIAN'] &&
        validStringLength(data.selectedCefrLevel, 0, 8) &&
        validStringLength(data.studyDirection, 3, 17) &&
        data.studyDirection in ['NATIVE_TO_FOREIGN', 'FOREIGN_TO_NATIVE', 'MIX'] &&
        validStringLength(data.todayDate, 10, 10) &&
        data.todayDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        isIntInRange(data.todayCompleted, 0, 5000) &&
        isIntInRange(data.todayBaseXp, 0, 10000) &&
        validStringLength(data.weeklyDailyLog, 0, 20000) &&
        isIntInRange(data.totalAttempts, 0, 5000000) &&
        isIntInRange(data.totalCorrect, 0, 5000000) &&
        isIntInRange(data.totalSpoken, 0, 2000000) &&
        isIntInRange(data.completedSessions, 0, 200000) &&
        isIntInRange(data.streakDays, 0, 10000) &&
        validStringLength(data.lastStudyDate, 0, 10) &&
        (data.lastStudyDate == '' || data.lastStudyDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
        validStringLength(data.masteredWordIds, 0, 400000) &&
        validStringLength(data.needsReviewWordIds, 0, 200000) &&
        validStringLength(data.wordSrsStats, 0, 600000);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public-to-auth leaderboard without PII; strictly owner-written
    match /leaderboard/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) &&
        uidUnchanged() &&
        isValidLeaderboardEntry(request.resource.data, uid);
      allow update: if isOwner(uid) &&
        uidNotModified() &&
        areImmutableFieldsUnchanged(['uid']) &&
        isValidLeaderboardEntry(request.resource.data, uid);
      allow delete: if isOwner(uid);
    }

    // Private cross-device full-progress backup; strictly non-anonymous owner only
    match /user_backups/{uid} {
      allow read: if isNonAnonymousOwner(uid);
      allow create: if isNonAnonymousOwner(uid) &&
        uidUnchanged() &&
        isValidUserBackup(request.resource.data, uid);
      allow update: if isNonAnonymousOwner(uid) &&
        uidNotModified() &&
        areImmutableFieldsUnchanged(['uid']) &&
        isValidUserBackup(request.resource.data, uid);
      allow delete: if isNonAnonymousOwner(uid);
    }

    // Default deny for all other collections and nested subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
